DATABASE_URL=sqlite:///./database.db
API_PREFIX=/api
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Local development: set one of these
GEMINI_API_KEY=your-gemini-api-key-here
# GOOGLE_API_KEY=your-google-api-key-here

GEMINI_MODEL=gemini-3.1-flash-lite
JOB_EXECUTION_MODE=background
STORY_GENERATION_RETRIES=2
STALE_JOB_TIMEOUT_SECONDS=900

# AWS queue mode only
# STORY_JOB_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/the-adventure-story-jobs
# AWS_REGION=ap-south-1
