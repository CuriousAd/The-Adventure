DATABASE_URL=sqlite:///./database.db
API_PREFIX=/api
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Local development: set one of these. Use commas for multiple keys.
GEMINI_API_KEYS=your-first-gemini-api-key,your-second-gemini-api-key
GEMINI_API_KEY=your-gemini-api-key-here
# GOOGLE_API_KEY=your-google-api-key-here

GEMINI_MODEL=gemini-3.1-flash-lite
JOB_EXECUTION_MODE=background
STORY_GENERATION_RETRIES=2
STORY_TASK_MAX_ATTEMPTS=3
STORY_REPAIR_RETRIES=1
STALE_JOB_TIMEOUT_SECONDS=900
DEFAULT_STORY_DEPTH=8
MAX_STORY_DEPTH=8
MIN_ENDING_DEPTH=4
DEFAULT_BRANCHING_FACTOR=2
LAZY_INITIAL_DEPTH=2
LAZY_PREFETCH_ENABLED=True

# AWS Step Functions workflow mode
# JOB_EXECUTION_MODE=workflow
# STORY_WORKFLOW_ARN=arn:aws:states:ap-south-1:123456789012:stateMachine:TheAdventureStoryWorkflow
# AWS_REGION=ap-south-1
